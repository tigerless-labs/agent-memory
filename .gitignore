benchmarks/
.index/
.state/
.env
.venv/
__pycache__/
*.pyc
.coverage
experiments/data/
# Run records are the evidence and are committed. Everything else a run leaves behind —
# stores, working directories, progress logs — is regenerable and large, so the rule is a
# whitelist: nothing under runs/ is tracked unless it is named here.
experiments/runs/**
!experiments/runs/**/
!experiments/runs/*/runs.jsonl
!experiments/runs/*/questions.json
!experiments/runs/*-report.txt
